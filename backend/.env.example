# Database
DATABASE_URL=postgresql://moontest:moontest123@localhost:5432/moontest

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=password123
STORAGE_BUCKET=moontest

# AI Model
MODEL_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
MODEL_API_KEY=your_api_key_here
MODEL_NAME=qwen-plus
MODEL_DEBUG_NAME=glm-4

# Token Configuration
TOKEN_QUOTA=100000
TOKEN_WARNING_RATE=0.1

# Execution Configuration
EXECUTION_TIMEOUT=600
MAX_RETRY_COUNT=3
SSE_TIMEOUT=1800

# Self-Healing Configuration
HEAL_CACHE_TTL_SUCCESS=30
HEAL_CACHE_TTL_FAIL=1
HEAL_CONFIDENCE_THRESHOLD=3

# Security
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application
APP_NAME=MoonTest
APP_VERSION=1.0.0
DEBUG=true
